# Server (required)
DATABASE_URL=  # Postgres (Supabase) connection string
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Client (Vite — set in Vercel for Production/Preview; must be available at build time)
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics (Umami). Both must be set or the script is omitted.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

ADMIN_PASSWORD=

# Optional
PORT=3000
