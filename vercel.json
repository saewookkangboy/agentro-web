{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build:vercel",
  "functions": {
    "server.js": {
      "includeFiles": "public/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/instructors", "destination": "/coaches", "permanent": true },
    { "source": "/instructors/:slug", "destination": "/coaches/:slug", "permanent": true },
    { "source": "/admin/instructors", "destination": "/admin/coaches", "permanent": true }
  ]
}
